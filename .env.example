# Einstellungen für docker-compose.yml (Hostinger Docker Manager, Anleitung:
# docs/HOSTINGER.md). Hostinger legt diese Datei beim ersten Bereitstellen als .env an.
# Alle Felder dürfen leer bleiben: Der erste Start klappt ohne jeden Wert. Geheimnisse
# (Datenbankpasswort, Schlüssel) erzeugt der Dienst init selbst; sie gehören nie hierher.
# Werte ohne Anführungszeichen eintragen, nur ADMIN_PASSWORD in einfachen (siehe dort).

# --- Pflicht für den Betrieb (nach dem ersten Bereitstellen ausfüllen) ---------------

# Die Adresse der App, NUR der Hostname, klein geschrieben, z. B. wiki.meine-firma.de
# oder der Hostname des VPS (srvNNNNNN.hstgr.cloud). Ohne https://, ohne Pfad, ohne
# Port, keine IP-Adresse; Umlaute in der xn--Form (init nennt sie). Ein DNS-A-
# Eintrag dieses Namens muss auf die IP-Adresse des VPS zeigen; das Zertifikat holt
# Traefik dann von selbst. Leer: Die App läuft, ist aber von außen nicht erreichbar.
DOMAIN=

# --- Einmal-Werte: die erste Person (Inhaberin, volle Rechte) ------------------------

# E-Mail-Adresse, mit der sich die erste Person anmeldet.
ADMIN_EMAIL=
# Ihr erstes Passwort, IN EINFACHEN ANFÜHRUNGSZEICHEN: ADMIN_PASSWORD='mein Passwort'.
# Ohne sie schneidet Compose es still ab: ab " #" gilt der Rest als Kommentar, und $
# wird als Variable gelesen. Ein ' darf nicht darin vorkommen. 10 bis 200 Zeichen,
# nicht auf der Liste bekannter geleakter Passwörter, ohne Wörter aus der E-Mail-
# Adresse. Die Person entsteht nur, solange es noch niemanden gibt. Nach der ersten
# Anmeldung hier wieder LEEREN und neu bereitstellen; das Passwort in der App ändern.
ADMIN_PASSWORD=

# --- Traefik (nur ändern, wenn Hostingers Traefik anders eingerichtet ist) ----------

# Name des Docker-Netzes, über das Traefik die App erreicht. Leer: herd-web.
TRAEFIK_NETWORK=
# Name des HTTPS-Entrypoints in /docker/traefik/docker-compose.yml. Leer: websecure.
TRAEFIK_ENTRYPOINT=
# Name des Zertifikat-Resolvers dort. Leer: letsencrypt.
TRAEFIK_CERTRESOLVER=

# --- Version ------------------------------------------------------------------------

# Welche Version des Images läuft, z. B. 1.0 (die neueste 1.0.x; jede Bereitstellung
# holt sie neu) oder 1.0.3 (genau diese). Leer: 1.0. Für eine neue Hauptversion hier
# eintragen und neu bereitstellen; vorher sichern (docs/HOSTINGER.md, „Updates“).
HERD_IMAGE_TAG=

# --- Sicherungen (optional) ---------------------------------------------------------

# Wann gesichert wird: Cron mit fünf Feldern, Zeit in UTC. Leer: 30 2 * * * (täglich
# 02:30 UTC).
HERD_BACKUP_SCHEDULE=
# Wie viele Sicherungen bleiben: die neueste jedes der letzten Tage, Wochen und
# Monate. Leer: 7, 4 und 6.
HERD_BACKUP_KEEP_DAILY=
HERD_BACKUP_KEEP_WEEKLY=
HERD_BACKUP_KEEP_MONTHLY=
# Nach wie vielen Stunden ohne gute Sicherung der Alarm HerdBackupTooOld anschlägt.
# Sichtbar nur mit einem eigenen Prometheus, den dieser Stack nicht mitbringt; hier
# zeigt "backup list" den Stand (docs/HOSTINGER.md, „Sicherungen“). Leer: 26.
HERD_BACKUP_ALERT_AFTER_HOURS=

# --- Feinheiten (optional) ----------------------------------------------------------

# Speicher (MB), den die Live-Bearbeitung für geöffnete Seiten nutzt, bevor sie weitere
# ablehnt. Auf kleinen VPS (2 GB RAM) z. B. 200. Leer: 400.
HERD_COLLAB_MEMORY_BUDGET_MB=
# Wie viele Läufe von KI-Agenten gleichzeitig arbeiten. Leer: 4.
HERD_RUN_CONCURRENCY=
# Ausführlichkeit der Protokolle: DEBUG, INFO, WARNING oder ERROR. Leer: INFO.
HERD_LOG_LEVEL=
# Adressen, deren X-Forwarded-For-Angaben die App glaubt (der Proxy davor), durch Komma
# getrennt. Leer: die privaten Netze 172.16.0.0/12, 10.0.0.0/8 und 192.168.0.0/16; das
# glaubt jedem Container im Netz herd-web. Enger: nur das Gateway dieses Netzes, über
# das Hostingers Traefik kommt (docs/HOSTINGER.md, „Absender-Adressen enger fassen“).
HERD_FORWARDED_ALLOW_IPS=
