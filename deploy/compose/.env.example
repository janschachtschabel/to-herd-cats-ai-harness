# Copy to .env and replace every value. Passwords: long random strings,
# e.g. `openssl rand -hex 24` (avoid `$`, which compose would interpolate).
POSTGRES_PASSWORD=replace-with-random-hex
HERD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HERD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-hex
# Shared secret of the API and the live-editing process: `openssl rand -hex 32`.
HERD_INTERNAL_TOKEN=replace-with-random-hex
# Optional: the address browsers use (scheme://host[:port]), e.g. https://wiki.example
HERD_PUBLIC_URL=
