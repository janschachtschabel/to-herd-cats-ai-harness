# Copy to .env and replace every value. Passwords: long random strings,
# e.g. `openssl rand -hex 24` (avoid `$`, which compose would interpolate).
POSTGRES_PASSWORD=replace-with-random-hex
HERD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HERD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-hex
# Shared secret of the API and the live-editing process: `openssl rand -hex 32`.
HERD_INTERNAL_TOKEN=replace-with-random-hex
# Optional: the address browsers use (scheme://host[:port]), e.g. https://wiki.example
HERD_PUBLIC_URL=
# Optional: attachments in an S3-compatible store instead of the volume app-data
# (docs/SICHERUNG.md, "Anhänge in S3"; compose.s3.yml runs SeaweedFS and needs only the
# two keys). HERD_STORAGE=s3 with the endpoint (scheme://host[:port]), the bucket, its
# region (most stores accept us-east-1) and keys; HERD_S3_PREFIX: lower-case segments.
HERD_STORAGE=local
HERD_S3_ENDPOINT=
HERD_S3_REGION=us-east-1
HERD_S3_BUCKET=
HERD_S3_ACCESS_KEY_ID=
HERD_S3_SECRET_ACCESS_KEY=
HERD_S3_PREFIX=
