# AI keys (M5, M6; docs/KI.md, docs/AGENTEN.md). Optional: copy to ai.env next to
# compose.yml; the app (and in compose.nodes.yml the API nodes and the worker) read it
# as their environment. Without it the app runs without stored AI keys: connections
# can then reference no key, and none can be stored encrypted.
#
# The key for keys stored encrypted (`enc:`), at least 32 characters:
# `openssl rand -hex 32`. Keep it: without it the stored keys cannot be read.
HERD_SECRET_KEY=
# Only while rotating the key (docs/KI.md, "Schlüssel"): the old key, then remove it.
# HERD_SECRET_KEY_PREVIOUS=
# Optional: the proxy provider calls go through, http://[user:password@]host:port
# (environment proxy variables such as HTTPS_PROXY are ignored on purpose).
# HERD_AI_EGRESS_PROXY=
# Provider keys that connections reference as env:HERD_AI_<NAME>, for example:
# HERD_AI_OPENAI_KEY=
