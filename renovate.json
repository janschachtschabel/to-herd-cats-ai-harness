{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "commitMessagePrefix": "deps:",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Python stays on 3.13 and Node on 22 (spec); only patch releases and digests.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.13(\\.\\d+)?-slim$/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^22(\\.\\d+)*-slim$/"
    },
    {
      "description": "PostgreSQL major upgrades need a dump and restore: digests only.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["pgvector/pgvector"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Actions: one grouped PR for digest and minor updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The bundled PostgreSQL image in the chart values (image:tag@digest).",
      "managerFilePatterns": ["/^deploy/helm/to-herd-cats-ai/values\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>pgvector/pgvector):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
